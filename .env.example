# Google Analytics
VITE_GA_MEASUREMENT_ID=G-SZ7VX12KWH

# Environment
VITE_ENV=development

# Firebase Cloud Function API origin. Visitors remain on the Hostinger domain.
VITE_CRM_API_BASE_URL=https://hsp-crm.web.app

# Local-only chat development. Production uses HSP CRM/functions/.env.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Hostinger deployment credential. Never commit a real value.
HOSTINGER_FTP_HOST=certificate-valid-hostname-from-hostinger
# Optional when Hostinger supplies an IP but its certificate names a different host.
HOSTINGER_FTP_CONNECT_IP=ftp-server-ip-from-hostinger
HOSTINGER_FTP_USER=site-specific-ftp-user
HOSTINGER_FTP_PASSWORD=your-hostinger-ftp-password
