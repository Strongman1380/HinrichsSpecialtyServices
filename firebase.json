{
  "hosting": {
    "site": "hinrichsspecialtyservices",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/terms.html/",
        "destination": "/terms.html"
      },
      {
        "source": "/privacy.html/",
        "destination": "/privacy.html"
      },
      {
        "source": "/terms",
        "destination": "/terms.html"
      },
      {
        "source": "/terms/",
        "destination": "/terms.html"
      },
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "/privacy/",
        "destination": "/privacy.html"
      },
      {
        "source": "/links",
        "destination": "/links.html"
      },
      {
        "source": "/links/",
        "destination": "/links.html"
      }
    ]
  }
}
