# Firebase Functions runtime environment.
# Copy to functions/.env for local/deploy-time env loading, or set these through Firebase/GCP secret management.

ALLOWED_ORIGIN=https://www.hinrichsspecialtyservices.com,https://hinrichsspecialtyservices.com,https://hsp-crm.web.app,http://127.0.0.1:4173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:5173
# Required for automatic campaign email delivery.
SENDGRID_API_KEY=sendgrid_key_here
SENDGRID_FROM_EMAIL=billing@yourdomain.com
SENDGRID_FROM_NAME=Hinrichs Specialty Services

# Required for AI survey builder.
ANTHROPIC_API_KEY=anthropic_key_here

# Optional for the legacy notify route.
RESEND_API_KEY=resend_key_here
RESEND_FROM_EMAIL=billing@hinrichsspecialtyservices.com
RESEND_FROM_NAME=Hinrichs Specialty Services
NOTIFY_EMAIL=bhinrichs1380@gmail.com
